# Krishna's Kitchen browser environment.
# Copy this file to .env.local for local development or configure the same
# variables in Vercel for Preview and Production environments.

# App
VITE_APP_NAME="Krishna's Kitchen"
# Allowed values: development, staging, production.
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Supabase browser client.
# Use the public project URL and anon key from Supabase Project Settings > API.
# Never place service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
