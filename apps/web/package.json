{
  "name": "@krishnas-kitchen/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:inventory": "vitest run src/domains/inventory",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@krishnas-kitchen/types": "workspace:*",
    "@krishnas-kitchen/ui": "workspace:*",
    "@krishnas-kitchen/utils": "workspace:*",
    "@supabase/supabase-js": "^2.48.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.8"
  }
}
