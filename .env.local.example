# Copy to .env.local and fill with local developer values.
VITE_APP_NAME="Krishna's Kitchen"
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR_LOCAL_SUPABASE_ANON_KEY

# Optional local OCR testing through the Vercel dev server.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_RECEIPT_OCR_MODEL=gpt-4.1-mini
